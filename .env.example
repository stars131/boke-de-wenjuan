ADMIN_IS_SUPER="true"

CONTACT_ENCRYPTION_KEY="replace-with-base64-32-byte-key"
HASH_SECRET="replace-with-hash-secret"

APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
